{
    "name": "webong/cogent",
    "type": "library",
    "description": "Laravel Eloquent collection extensions: plug, include and count relations without extra queries.",
    "keywords": [
        "laravel",
        "eloquent",
        "collection",
        "relations",
        "hydration",
        "performance"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Webong",
            "homepage": "https://webong.dev"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/cache": "^12.0",
        "illuminate/console": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "dedoc/scramble": "^0.13.53",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Webong\\Cogent\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Webong\\Cogent\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=-1"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webong\\Cogent\\CogentServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
