includes:
    - vendor/larastan/larastan/extension.neon

services:
    -
        class: Webong\Cogent\PhpStan\CachedRelationMacroExtension
        tags:
            - phpstan.broker.methodsClassReflectionExtension

parameters:
    excludePaths:
        # The macro is bound to the relation at call time, so $this only exists there.
        - src/Support/CachedRelationMacro.php
    paths:
        - src/
        - tests/Fixtures/
    level: 5
    tmpDir: .phpstan.cache
